# Copy this file to .env and fill in real values. Never commit .env.

# HTTP and Service Ports
HTTP_PORT=api-gateway:8080
AUTH_SERVICE_PORT=auth-service:50051
BOOKING_SERVICE_PORT=booking-service:50052

# Database configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=auth_i

# Token secrets (JWT signing key; must match ACCESS_TOKEN in Auth_Service/.env)
ACCESS_TOKEN=changeme_access_secret
