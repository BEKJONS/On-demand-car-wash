# Copy this file to .env and fill in real values. Never commit .env.

# Ports for services
AUTH_ROUTER_PORT=auth-service:8081
AUTH_SERVICE_PORT=auth-service:50051

# Database configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_NAME=auth_i
DB_PASSWORD=changeme

# Token secrets (JWT signing keys; use long random values)
# ACCESS_TOKEN must match ACCESS_TOKEN in api-gateway/.env
ACCESS_TOKEN=changeme_access_secret
REFRESH_TOKEN=changeme_refresh_secret
