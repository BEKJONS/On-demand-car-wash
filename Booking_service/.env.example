# Copy this file to .env and adjust values. Never commit .env.

# Ports for services
AUTH_SERVICE_PORT=auth-service:50051
BOOKING_SERVICE_PORT=booking-service:50052

# MongoDB Configuration
MongoDB_NAME=booking
MongoURI=mongodb://mongo-db:27017

# RabbitMQ (guest:guest is the stock RabbitMQ default used by docker-compose;
# change it if your broker uses other credentials)
RABBIT=amqp://guest:guest@rabbitmq:5672/
RABBITL=amqp://guest:guest@localhost:5672/
